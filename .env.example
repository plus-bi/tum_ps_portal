REDIS_URL=redis://redis:6379/0
PUBLIC_URL=http://localhost:8080
PORTAL_DOMAIN=:80
PORTAL_HTTP_PORT=8080
PORTAL_HTTPS_PORT=8443
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=
CLERK_ISSUER=
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Show unapproved organization candidates only on a local host.
ORGANIZATION_ATTRIBUTION_PREVIEW=false
CRAWLER_DELAY_SECONDS=3.0
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_ATTEMPTS=3
CRAWLER_MAX_CONTENT_BYTES=25000000
CELERY_WORKER_CONCURRENCY=2
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ADMIN_ALERT_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated project reference codes shown before other catalog results.
PINNED_PROJECTS=ps-041,ps-043

# Shared internal worker -> Next.js refresh credential; generate a random secret for deployment.
CATALOG_REVALIDATION_SECRET=
CATALOG_STORAGE_PATH=/var/lib/portal/catalog
CATALOG_WEB_URL=http://web:3000
